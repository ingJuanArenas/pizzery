### get all
GET http://localhost:8080/api/pizzas
Accept: application/json

### get by id 
GET http://localhost:8080/api/pizzas/4
Accept: application/json

### create pizza
POST http://localhost:8080/api/pizzas
Content-Type: application/json

{
  "name": "Colombian top",
  "description": "Classic pizza with tomato sauce, mozzarella, and basil",
  "price": 8.99
}

### update pizza
PUT http://localhost:8080/api/pizzas/update/9
Content-Type: application/json

{
  "name": "Margherita Extra Cheese",
  "description": "Classic pizza with extra mozzarella and basil",
  "price": 9.99
}

### delete pizza
DELETE http://localhost:8080/api/pizzas/9